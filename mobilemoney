#metamorphoo-logo{
    display: relative;
    height: auto;
    width: 100%;
}
#homepage-link{
    color: orange;
    text-decoration: none;
    font-size: 1.4rem;
    margin-left: 30px;
    margin-right: 10px;
    font-weight: bold;
}
#partnership-link{
    color: orange;
    text-decoration: none;
    font-size: 1.4rem;
    margin-left: 10px;
    font-weight: bold;
}
#homepage-link:hover, #partnership-link:hover{
    color: red;
}
#blessings{
    text-align: center;
    color: red;
}
.partner-container{
    max-width: 800px;
    margin: 40px auto;
    padding: 35px;
    border-radius: 10px;
    background-color: red;
    box-shadow: 50px #fff;
}
#preffered-method{
    font-size: 1.7rem;
    color: #fff;
}
.payment-methods{
    display: flex;
    flex-direction: column;
    align-items: center;
}
.payment-method{
    margin: 10px;
    padding: 15px;
    border: 1px solid orange;
    border-radius: 10px;
    cursor: pointer;
    width: 100%;
    box-shadow: 75px;
    display: flex;
    background-color: orange;
}
#mobilemoney-image{
    display: absolute;
    height: 5rem;
    width: 8rem;
}
#bank-image{
    display: absolute;
    height: 5rem;
    width: 8rem;
}
#mastercard-image{
    display: absolute;
    height: 5rem;
    width: 8rem;
}
#payment-text{
    text-decoration: none;
    color: red;
    font-weight: bold;
    font-size: 1.3em;
    text-align: center;
    padding: 30px;
}
.confirmation{
    display: none;
    margin-top: 20px;
    padding: 20px;
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
    border-radius: 5px;
    text-align: center;
}
@media (max-width: 600px){
    .payment-method{
        margin: 10px 0;
    }
    .partner{
        width: 100%;
    }
}
/* CSS for the momo partner*/
.momo-container{
    width: auto;
    margin: 40px auto;
    padding: 20px;
    border: 1px solid #ddd;
    border-radius: 10px;
    box-shadow: 10 10 100px #f0f0f0;
    background-color: #fff;
    font-size: 18px;
    box-shadow: 5px 5px 25px  red;
    transition: all 5s;

}
#paymentMomo{
    text-align: center;
    color: red;
    font-size: 2rem;
    font-weight: bold;
}
.momo-grid{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}
.momo-item{
    display: absolute;
    padding: 0;
    height: 4rem;
    width: 7rem;
    border: 2px solid orange;
    border-radius: 10px;
    background-color: rgb(239, 238, 250);
    transition: all 0.3s;
    box-shadow: 5px 5px 5px orange;
}
label{
    cursor: pointer;
}
input[type="checkbox"],
input[type="text"] {
    margin-right: 10px;
}
#momo-image{
    height: 3rem;
    width: 7rem;
    margin-top: -15px;
    margin-left: 9px;
}
#voda-image{
    height: 3rem;
    width: 5rem;
    margin-top: -15px;
    margin-left: 23px;
}
#at-image{
    height: 3rem;
    width: 5rem;
    margin-top: -15px;
    margin-left: 23px;
}
.form-group{
    margin-top: 20px;
}
#phoneNumber{
    width: 100%;
    height: 30px;
    border: 1px solid red;
    background-color: rgb(231, 219, 149);
}
.PartnerNow{
    display: absolute;
    padding: 10px 20px;
    background-color: red;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
    margin-top: 20px;
}
#partner-now{
    text-align: center;
    font-weight: bold;
    font-size: 15px;
}
.PartnerNow:hover{
    background-color: orange;
}